{
  "name": "@omicronenergy/oscd-editor-sld",
  "description": "OpenSCD plugin for designing single line diagrams",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-editor-sld.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-editor-sld/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec81650"
  ],
  "contributors": [
    "OMICRON Electronics GmbH"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/oscd-editor-sld.js",
    "./oscd-editor-sld.js": "./dist/oscd-editor-sld.js"
  },
  "files": [
    "/dist/",
    "!/dist/*.spec.*",
    "!/dist/*.test.*"
  ],
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "analyze": "oscd analyze",
    "marked": "marked -i src/about.md -o src/about.html && cp src/about.html dist/about.html",
    "start": "oscd clean && npm run marked && oscd start --no-clean",
    "start:bundle": "npm run bundle && oscd start-bundle --no-build",
    "build": "oscd build && npm run marked",
    "bundle": "oscd clean && npm run marked && oscd bundle --no-clean",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "test:update": "oscd test --update",
    "updates": "oscd updates",
    "deploy": "oscd deploy",
    "prepare": "oscd install-hooks"
  },
  "dependencies": {
    "@omicronenergy/oscd-background-editv1": "^0.0.7",
    "@omicronenergy/oscd-editor": "^1.7.1",
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-scl-dialogs": "^0.0.15",
    "@omicronenergy/oscd-shell": "^0.0.13",
    "@omicronenergy/oscd-ui": "^0.0.14",
    "@open-wc/scoped-elements": "^3.0.10",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@omicronenergy/oscd-tooling": "^0.0.5",
    "marked": "^18.0.5",
    "sinon": "^22.0.0"
  },
  "customElements": "custom-elements.json"
}
